<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_reconcile_case" model="ir.sequence">
        <field name="name">Reconciliation Case</field>
        <field name="code">reconcile.case</field>
        <field name="prefix">REC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_reconcile_partner_confirmation" model="ir.sequence">
        <field name="name">Partner Balance Confirmation</field>
        <field name="code">reconcile.partner.confirmation</field>
        <field name="prefix">CONF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="ir_cron_reconcile_case_sla" model="ir.cron">
        <field name="name">Reconciliation: Schedule overdue case activities</field>
        <field name="model_id" ref="model_reconcile_case"/>
        <field name="state">code</field>
        <field name="code">model._cron_schedule_overdue_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
