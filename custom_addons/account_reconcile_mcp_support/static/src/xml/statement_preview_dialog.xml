<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account_reconcile_mcp_support.StatementPreviewDialog">
        <div class="ocr-preview-modal d-flex flex-column h-100 w-100 bg-white">
            <!-- HEADER TOOLBAR -->
            <header class="ocr-preview-header d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-light">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-5 fw-bold text-dark">
                        <i class="fa fa-eye text-primary me-2"/>AI Statement Preview &amp; Verification
                    </span>
                    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                        <i class="fa fa-bolt me-1 text-warning"/> <t t-esc="engine"/>
                    </span>
                    <span class="badge rounded-pill bg-light text-muted border px-2 py-1" t-att-title="fileName">
                        <i class="fa fa-file-pdf-o text-danger me-1"/> <t t-esc="fileName"/>
                    </span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <!-- SUMMARY STATS -->
                    <div class="d-flex align-items-center gap-3 bg-white px-3 py-1 rounded border shadow-sm fs-7">
                        <div>
                            <span class="text-muted me-1">Lines:</span>
                            <strong class="text-dark"><t t-esc="state.records.length"/></strong>
                        </div>
                        <div class="vr"/>
                        <div>
                            <span class="text-muted me-1">Inflow (+):</span>
                            <strong class="text-success">+<t t-esc="formatCurrency(totalCredit)"/></strong>
                        </div>
                        <div class="vr"/>
                        <div>
                            <span class="text-muted me-1">Outflow (-):</span>
                            <strong class="text-danger">-<t t-esc="formatCurrency(totalDebit)"/></strong>
                        </div>
                    </div>

                    <!-- ACTION BUTTONS -->
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm px-3 fw-semibold shadow-sm" t-on-click="onAddManualRecord">
                            <i class="fa fa-plus me-1"/> Add Manual
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm px-3" t-on-click="onClose">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-success btn-sm px-3 fw-bold shadow-sm" t-on-click="onConfirmImport" t-att-disabled="state.isSaving">
                            <i t-if="state.isSaving" class="fa fa-spinner fa-spin me-1"/>
                            <i t-else="" class="fa fa-check me-1"/>
                            Confirm &amp; Import to Journal
                        </button>
                    </div>
                </div>
            </header>

            <!-- MAIN SPLIT SCREEN VIEW -->
            <main class="ocr-preview-body d-flex flex-grow-1 overflow-hidden">
                <!-- LEFT SIDEBAR: GLOBAL BALANCE LIST -->
                <section class="ocr-preview-sidebar d-flex flex-column border-end bg-light">
                    <!-- GLOBAL BALANCE HEADER (OCA MATCHING STYLE) -->
                    <div class="ocr-global-balance-header p-3 border-bottom bg-white d-flex align-items-center justify-content-between shadow-sm">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4 fw-bold text-dark">Global Balance</span>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">
                                <t t-esc="state.records.length"/>
                            </span>
                        </div>
                        <div class="fs-4 fw-bold" t-att-class="globalBalance >= 0 ? 'text-success' : 'text-danger'">
                            <t t-esc="globalBalanceStr"/>
                        </div>
                    </div>

                    <!-- SEARCH & QUICK ADD BAR -->
                    <div class="p-2 border-bottom bg-white d-flex align-items-center gap-2">
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text bg-light border-end-0"><i class="fa fa-search text-muted"/></span>
                            <input type="text" class="form-control border-start-0" placeholder="Search by partner, amount, description..." t-model="state.filterText"/>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary" t-on-click="onAddManualRecord" title="Add manual line">
                            <i class="fa fa-plus"/>
                        </button>
                    </div>

                    <!-- CARDS CONTAINER (SCROLLABLE) -->
                    <div class="ocr-records-list flex-grow-1 overflow-y-auto p-2 d-flex flex-column gap-2">
                        <t t-if="filteredRecords.length === 0">
                            <div class="text-center text-muted p-4">
                                <i class="fa fa-inbox fa-3x mb-2 text-black-50"/>
                                <p class="mb-0">No matching transactions found.</p>
                            </div>
                        </t>

                        <t t-foreach="filteredRecords" t-as="rec" t-key="rec.temp_id">
                            <div class="ocr-record-card p-2 rounded border bg-white shadow-sm position-relative"
                                 t-att-class="state.selectedTempId === rec.temp_id ? 'active-card' : ''"
                                 t-on-click="() => this.onSelectRecord(rec)">
                                
                                <!-- ROW 1: DATE & AMOUNT -->
                                <div class="d-flex align-items-center justify-content-between mb-1 gap-2">
                                    <div class="input-group input-group-sm ocr-date-input" style="max-width: 140px;">
                                        <input type="date" class="form-control form-control-sm py-0 px-1 border-0 fw-semibold text-secondary"
                                               t-model="rec.date"
                                               t-on-click.stop=""
                                               title="Transaction date"/>
                                    </div>
                                    <div class="flex-grow-1 text-end">
                                        <input type="number" step="any"
                                               class="form-control form-control-sm py-0 px-1 text-end fw-bold border-0"
                                               t-att-class="rec.amount >= 0 ? 'text-success' : 'text-danger'"
                                               t-model.number="rec.amount"
                                               t-on-click.stop=""
                                               title="Amount (+ In, - Out)"/>
                                    </div>
                                </div>

                                <!-- ROW 2: PARTNER NAME -->
                                <div class="mb-1">
                                    <input type="text" class="form-control form-control-sm py-0 px-1 fw-bold text-dark border-0 border-bottom rounded-0 bg-transparent"
                                           placeholder="Partner name / Payer / Beneficiary..."
                                           t-model="rec.partner_name"
                                           t-on-click.stop=""
                                           title="Partner"/>
                                </div>

                                <!-- ROW 3: NARRATION / DESCRIPTION -->
                                <div class="mb-1">
                                    <textarea rows="2" class="form-control form-control-sm py-1 px-1 text-muted border-0 bg-light rounded"
                                              placeholder="Transaction narration / description..."
                                              t-model="rec.narration"
                                              t-on-click.stop=""
                                              title="Narration"/>
                                </div>

                                <!-- ROW 4: REF, PAGE BADGE & DELETE -->
                                <div class="d-flex align-items-center justify-content-between text-muted fs-8 pt-1">
                                    <div class="d-flex align-items-center gap-1 flex-grow-1 me-2">
                                        <i class="fa fa-tag text-muted"/>
                                        <input type="text" class="form-control form-control-sm py-0 px-1 border-0 bg-transparent text-muted"
                                               placeholder="Txn Ref"
                                               t-model="rec.ref"
                                               t-on-click.stop=""
                                               style="max-width: 130px; font-size: 0.75rem;"/>
                                    </div>

                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge bg-light text-muted border px-1" title="Scanned page">
                                            Page <t t-esc="rec.page_number || 1"/>
                                        </span>
                                        <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-1"
                                                t-on-click.stop="() => this.onDeleteRecord(rec.temp_id)"
                                                title="Delete this line">
                                            <i class="fa fa-trash-o"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </section>

                <!-- RIGHT SIDE: PDF DOCUMENT VIEWER & COORDINATES OVERLAY -->
                <section class="ocr-preview-doc-panel d-flex flex-column flex-grow-1 bg-secondary-subtle overflow-hidden">
                    <!-- DOCUMENT CONTROLS TOOLBAR -->
                    <div class="ocr-doc-toolbar d-flex align-items-center justify-content-between px-3 py-1 bg-white border-bottom shadow-sm">
                        <!-- PAGE CONTROLS -->
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="onPrevPage" t-att-disabled="state.currentPage &lt;= 1">
                                <i class="fa fa-chevron-left"/>
                            </button>
                            <span class="fs-7 fw-semibold">
                                Page <strong class="text-primary"><t t-esc="state.currentPage"/></strong> / <t t-esc="state.totalPages"/>
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="onNextPage" t-att-disabled="state.currentPage &gt;= state.totalPages">
                                <i class="fa fa-chevron-right"/>
                            </button>
                        </div>

                        <!-- ZOOM CONTROLS -->
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="onZoomOut" title="Zoom out">
                                <i class="fa fa-search-minus"/>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="onZoomReset" title="Reset 100%">
                                <t t-esc="state.zoom"/>%
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="onZoomIn" title="Zoom in">
                                <i class="fa fa-search-plus"/>
                            </button>
                        </div>

                        <!-- HINT -->
                        <div class="text-muted fs-8 d-none d-md-flex align-items-center gap-1">
                            <i class="fa fa-file-text-o text-primary me-1"/>
                            Cross-check extracted data against original document
                        </div>
                    </div>

                    <!-- DOCUMENT VIEWPORT -->
                    <div class="ocr-doc-viewport flex-grow-1 overflow-auto p-2 d-flex justify-content-center align-items-start" t-ref="docViewer">
                        <!-- RENDERED DOCUMENT PAGE (CLEAN VIEW - FULL WIDTH) -->
                        <div class="ocr-doc-page-container position-relative bg-white shadow-sm rounded"
                             t-att-style="'width: ' + renderedPageWidth + ';'">
                            
                            <!-- PAGE IMAGE (CRISP HIGH RESOLUTION) -->
                            <t t-if="currentPageImageSrc">
                                <img t-att-src="currentPageImageSrc"
                                     class="ocr-page-image d-block user-select-none w-100"
                                     alt="Statement Document"/>
                            </t>
                            <t t-else="">
                                <div class="p-5 text-center text-muted" style="min-height: 500px;">
                                    <i class="fa fa-spinner fa-spin fa-3x text-primary mb-3"/>
                                    <p class="fs-6">Preparing document page...</p>
                                </div>
                            </t>
                        </div>
                    </div>
                </section>
            </main>
        </div>
    </t>
</templates>
