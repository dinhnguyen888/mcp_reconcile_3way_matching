<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account_reconcile_mcp_support.DropzoneBinaryField">
        <div class="o_dropzone_wrapper" t-att-class="{'is-dragging': state.isDragging, 'has-file': hasFile}">
            <input type="file" t-ref="fileInput" class="d-none" t-on-change="onFileChange" accept=".pdf,.xlsx,.xls,.csv,.png,.jpg,.jpeg"/>

            <t t-if="!hasFile">
                <div class="dropzone-box text-center p-4 cursor-pointer"
                     t-on-dragover="onDragOver"
                     t-on-dragleave="onDragLeave"
                     t-on-drop="onDrop"
                     t-on-click="onClickUpload">
                    <div class="dropzone-icon mb-3">
                        <i class="fa fa-cloud-upload fa-3x text-primary"/>
                    </div>
                    <h5 class="dropzone-title fw-bold text-dark mb-1">
                        Drag and drop Bank Statement or Invoice here
                    </h5>
                    <p class="dropzone-subtitle text-muted mb-3 fs-7">
                        or <span class="text-primary text-decoration-underline cursor-pointer">browse file from your computer</span>
                    </p>
                    <div class="dropzone-badge badge bg-light text-primary border px-3 py-2 rounded-pill">
                        Supports PDF, Excel (.xlsx, .xls), CSV, Images (PNG, JPG)
                    </div>
                </div>
            </t>

            <t t-else="">
                <div class="dropzone-file-preview d-flex align-items-center justify-content-between p-3 border rounded shadow-sm bg-white">
                    <div class="d-flex align-items-center gap-3">
                        <div class="file-preview-icon bg-primary-subtle text-primary rounded p-3 d-flex align-items-center justify-content-center">
                            <i class="fa fa-file-pdf-o fa-2x text-danger" t-if="state.fileName.endsWith('.pdf')"/>
                            <i class="fa fa-file-excel-o fa-2x text-success" t-elif="state.fileName.endsWith('.xlsx') || state.fileName.endsWith('.xls') || state.fileName.endsWith('.csv')"/>
                            <i class="fa fa-file-image-o fa-2x text-info" t-elif="state.fileName.endsWith('.png') || state.fileName.endsWith('.jpg') || state.fileName.endsWith('.jpeg')"/>
                            <i class="fa fa-file-text-o fa-2x text-primary" t-else=""/>
                        </div>
                        <div>
                            <div class="file-name fw-bold text-dark text-truncate mb-1" style="max-width: 320px;" t-out="fileName"/>
                            <div class="file-meta text-muted fs-7 d-flex align-items-center gap-2">
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Ready to process</span>
                                <span t-if="state.fileSizeStr" t-out="state.fileSizeStr"/>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-2 ms-3" t-on-click="onRemoveFile" title="Remove file">
                        <i class="fa fa-trash"/>
                    </button>
                </div>
            </t>
        </div>
    </t>
</templates>
