    </record>
    <record id="rule_reconcile_import_batch_company" model="ir.rule">
        <field name="name">Reconciliation import batches by company</field>
        <field name="model_id" ref="model_reconcile_import_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_reconcile_case_line_company" model="ir.rule">
        <field name="name">Reconciliation case lines by company</field>
        <field name="model_id" ref="model_reconcile_case_line"/>
        <field name="domain_force">[('case_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_reconcile_transition_company" model="ir.rule">
        <field name="name">Reconciliation transitions by company</field>
        <field name="model_id" ref="model_reconcile_case_transition"/>
        <field name="domain_force">[('case_id.company_id', 'in', company_ids)]</field>
    </record>
