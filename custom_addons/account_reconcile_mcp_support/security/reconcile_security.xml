        <field name="name">Reconciliation match runs by company</field>
        <field name="model_id" ref="model_reconcile_match_run"/>
        <field name="domain_force">[('case_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_reconcile_match_candidate_company" model="ir.rule">
        <field name="name">Reconciliation candidates by company</field>
        <field name="model_id" ref="model_reconcile_match_candidate"/>
