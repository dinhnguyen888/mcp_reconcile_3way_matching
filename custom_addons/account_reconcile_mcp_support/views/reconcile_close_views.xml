<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reconcile_close_list" model="ir.ui.view">
        <field name="name">reconcile.close.checklist.list</field>
        <field name="model">reconcile.close.checklist</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="company_id"/>
                <field name="date_from"/><field name="date_to"/>
                <field name="responsible_id"/><field name="unresolved_count"/>
                <field name="unresolved_value"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_reconcile_close_form" model="ir.ui.view">
        <field name="name">reconcile.close.checklist.form</field><field name="model">reconcile.close.checklist</field>
        <field name="arch" type="xml">
            <form string="Period Close Checklist">
                <header>
                    <button name="action_refresh_checks" type="object" string="Refresh Checks" class="btn-primary" invisible="state not in ('draft', 'in_progress', 'reopened')"/>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state not in ('draft', 'reopened')"/>
                    <button name="action_submit" type="object" string="Submit" invisible="state != 'in_progress'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending_approval'" groups="account_reconcile_mcp_support.group_reconcile_approver"/>
                    <button name="action_lock" type="object" string="Lock" invisible="state != 'approved'" groups="account_reconcile_mcp_support.group_reconcile_period_lock"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state != 'locked'" groups="account_reconcile_mcp_support.group_reconcile_approver"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,pending_approval,approved,locked"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group><group><field name="company_id"/><field name="responsible_id"/></group><group><field name="date_from"/><field name="date_to"/><field name="unresolved_count" readonly="1"/><field name="unresolved_value" readonly="1"/></group></group>
                    <field name="notes"/>
                    <field name="reopened_reason" invisible="state != 'locked'"/>
                    <field name="line_ids"><list editable="bottom"><field name="sequence"/><field name="check_key"/><field name="state" widget="badge"/><field name="count"/><field name="impact_value"/><field name="is_automatic"/><field name="last_checked_at" optional="hide"/><field name="explanation"/><field name="evidence_ids" widget="many2many_binary" optional="hide"/><button name="action_pass" type="object" icon="fa-check" title="Pass" invisible="state == 'passed'"/><button name="action_fail" type="object" icon="fa-times" title="Fail" invisible="state == 'failed'"/><button name="action_waive" type="object" icon="fa-gavel" title="Waive" invisible="state == 'waived'" groups="account_reconcile_mcp_support.group_reconcile_approver"/></list></field>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_reconcile_close" model="ir.actions.act_window"><field name="name">Period Close Checklists</field><field name="res_model">reconcile.close.checklist</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_reconcile_close" name="Period Close" parent="menu_reconcile_root" action="action_reconcile_close" sequence="20"/>
</odoo>
