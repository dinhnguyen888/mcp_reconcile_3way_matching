<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reconcile_match_run_list" model="ir.ui.view">
        <field name="name">reconcile.match.run.list</field>
        <field name="model">reconcile.match.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="case_id"/>
                <field name="algorithm_version"/>
                <field name="status" widget="badge"/>
                <field name="candidate_count"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_reconcile_match_run_form" model="ir.ui.view">
        <field name="name">reconcile.match.run.form</field>
        <field name="model">reconcile.match.run</field>
        <field name="arch" type="xml">
            <form string="Matching Run">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="case_id"/>
                        <field name="algorithm_version"/>
                        <field name="input_hash"/>
                        <field name="status"/>
                        <field name="error_message" invisible="status != 'failed'"/>
                    </group>
                    <field name="candidate_ids">
                        <list editable="bottom" decoration-success="decision == 'accepted'" decoration-muted="decision == 'rejected'">
                            <field name="source_model"/>
                            <field name="source_res_id"/>
                            <field name="match_kind"/>
                            <field name="target_model"/>
                            <field name="target_res_id"/>
                            <field name="score"/>
                            <field name="score_breakdown"/>
                            <field name="decision" widget="badge"/>
                            <field name="override_reason"/>
                            <button name="action_accept" type="object" string="Accept" invisible="decision == 'accepted'"/>
                            <button name="action_reject" type="object" string="Reject" invisible="decision == 'rejected'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_reconcile_match_runs" model="ir.actions.act_window">
        <field name="name">Matching Runs</field>
        <field name="res_model">reconcile.match.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_reconcile_import_batch_list" model="ir.ui.view">
        <field name="name">reconcile.import.batch.list</field>
        <field name="model">reconcile.import.batch</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="document_type"/>
                <field name="journal_id"/>
                <field name="state" widget="badge"/>
                <field name="imported_count"/>
            </list>
        </field>
    </record>
    <record id="action_reconcile_import_batches" model="ir.actions.act_window">
        <field name="name">Import Batches</field>
        <field name="res_model">reconcile.import.batch</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_reconcile_match_runs" name="Matching Runs" parent="menu_reconcile_root" action="action_reconcile_match_runs" sequence="15" groups="account_reconcile_mcp_support.group_reconcile_reviewer"/>
    <menuitem id="menu_reconcile_import_batches" name="Import Batches" parent="menu_reconcile_root" action="action_reconcile_import_batches" sequence="25"/>
</odoo>
