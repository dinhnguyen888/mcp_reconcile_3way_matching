<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_mcp_scan" model="ir.ui.view">
        <field name="name">account.move.form.mcp.scan</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_mcp_bill_upload"
                        type="object"
                        string="Scan Bill (AI)"
                        class="btn-secondary"
                        groups="account.group_account_invoice"
                        invisible="move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_vendor_bill_scan"
              name="Scan Vendor Bill"
              parent="account.menu_finance_payables"
              action="action_vendor_bill_upload_wizard"
              groups="account.group_account_invoice"
              sequence="15"/>
</odoo>
