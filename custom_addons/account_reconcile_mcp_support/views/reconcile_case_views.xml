<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reconcile_case_list" model="ir.ui.view">
        <field name="name">reconcile.case.list</field>
        <field name="model">reconcile.case</field>
        <field name="arch" type="xml">
            <list decoration-danger="risk_level == 'critical'" decoration-warning="risk_level == 'high'">
                <field name="name"/>
                <field name="reconcile_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="partner_id"/>
                <field name="owner_id"/>
                <field name="due_date"/>
                <field name="variance_amount" sum="Variance"/>
                <field name="confidence"/>
                <field name="risk_level" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_reconcile_case_form" model="ir.ui.view">
        <field name="name">reconcile.case.form</field>
        <field name="model">reconcile.case</field>
        <field name="arch" type="xml">
            <form string="Reconciliation Case">
                <header>
                    <button name="action_collect_data" type="object" string="Collect Data" invisible="state != 'draft'"/>
                    <button name="action_run_matching" type="object" string="Run Matching" class="btn-primary" invisible="reconcile_type != 'bank' or state not in ('draft', 'collecting_data', 'needs_review')"/>
                    <button name="action_start_review" type="object" string="Start Review" class="btn-primary" invisible="state not in ('draft', 'collecting_data', 'reopened')"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state not in ('needs_review', 'waiting_warehouse', 'waiting_accounting', 'waiting_partner')" groups="account_reconcile_mcp_support.group_reconcile_approver"/>
                    <button name="action_reconcile" type="object" string="Mark Reconciled" invisible="state != 'approved'"/>
                    <button name="action_lock" type="object" string="Lock" invisible="state != 'reconciled'" groups="account_reconcile_mcp_support.group_reconcile_period_lock"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state != 'locked'" groups="account_reconcile_mcp_support.group_reconcile_approver"/>
                    <button name="action_wait_warehouse" type="object" string="Wait Warehouse" invisible="state != 'needs_review'"/>
                    <button name="action_wait_accounting" type="object" string="Wait Accounting" invisible="state != 'needs_review'"/>
                    <button name="action_wait_partner" type="object" string="Wait Partner" invisible="state != 'needs_review'"/>
                    <button name="action_return_review" type="object" string="Return to Review" invisible="state not in ('waiting_warehouse', 'waiting_accounting', 'waiting_partner', 'rejected', 'carried_forward')"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state not in ('needs_review', 'waiting_warehouse', 'waiting_accounting', 'waiting_partner')" groups="account_reconcile_mcp_support.group_reconcile_approver"/>
                    <button name="action_carry_forward" type="object" string="Carry Forward" invisible="state not in ('needs_review', 'waiting_warehouse', 'waiting_accounting', 'waiting_partner')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'collecting_data', 'needs_review', 'reopened', 'rejected', 'carried_forward')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,needs_review,approved,reconciled,locked"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="reconcile_type"/>
                            <field name="company_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="partner_id"/>
                            <field name="owner_id"/>
                            <field name="approver_id"/>
                        </group>
                        <group>
                            <field name="period_date"/>
                            <field name="due_date"/>
                            <field name="priority" widget="priority"/>
                            <field name="risk_level" widget="badge"/>
                            <field name="department"/>
                            <field name="reason_code"/>
                            <field name="confidence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Variance">
                            <group>
                                <group><field name="expected_amount"/><field name="actual_amount"/><field name="variance_amount" readonly="1"/></group>
                                <group><field name="expected_quantity"/><field name="actual_quantity"/><field name="variance_quantity" readonly="1"/></group>
                            </group>
                            <group><field name="reason"/><field name="resolution"/></group>
                            <group><field name="reopened_reason" invisible="state != 'locked'"/></group>
                        </page>
                        <page string="Source Documents">
                            <field name="source_line_ids">
                                <list editable="bottom">
                                    <field name="source_role"/><field name="source_model"/><field name="source_res_id"/><field name="source_line_id"/>
                                    <field name="expected_amount"/><field name="actual_amount"/><field name="expected_quantity"/><field name="actual_quantity"/><field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Matching Runs">
                            <field name="match_run_ids" readonly="1">
                                <list><field name="name"/><field name="algorithm_version"/><field name="status"/><field name="candidate_count"/></list>
                            </field>
                        </page>
                        <page string="Evidence"><field name="attachment_ids" widget="many2many_binary"/></page>
                        <page string="Audit">
                            <field name="transition_ids" readonly="1">
                                <list><field name="create_date"/><field name="from_state"/><field name="to_state"/><field name="user_id"/><field name="note"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_reconcile_tolerance_list" model="ir.ui.view">
        <field name="name">reconcile.tolerance.list</field><field name="model">reconcile.tolerance</field>
        <field name="arch" type="xml">
            <list><field name="sequence"/><field name="name"/><field name="company_id"/><field name="case_type"/><field name="amount_absolute"/><field name="percentage"/><field name="approval_level"/><field name="active"/></list>
        </field>
    </record>
    <record id="view_reconcile_tolerance_form" model="ir.ui.view">
        <field name="name">reconcile.tolerance.form</field><field name="model">reconcile.tolerance</field>
        <field name="arch" type="xml">
            <form string="Reconciliation Tolerance"><sheet><group><field name="name"/><field name="active"/><field name="sequence"/><field name="company_id"/><field name="case_type"/><field name="partner_id"/><field name="currency_id"/></group><group><field name="amount_absolute"/><field name="percentage"/><field name="quantity"/><field name="days"/><field name="approval_level"/><field name="writeoff_account_id"/></group></sheet></form>
        </field>
    </record>
    <record id="action_reconcile_cases" model="ir.actions.act_window"><field name="name">Reconciliation Cases</field><field name="res_model">reconcile.case</field><field name="view_mode">list,form</field></record>
    <record id="view_reconcile_case_pivot" model="ir.ui.view">
        <field name="name">reconcile.case.pivot</field><field name="model">reconcile.case</field>
        <field name="arch" type="xml"><pivot string="Reconciliation Cases"><field name="reconcile_type" type="row"/><field name="state" type="col"/><field name="variance_amount" type="measure"/><field name="id" type="measure"/></pivot></field>
    </record>
    <record id="view_reconcile_case_graph" model="ir.ui.view">
        <field name="name">reconcile.case.graph</field><field name="model">reconcile.case</field>
        <field name="arch" type="xml"><graph string="Exceptions by State"><field name="state"/><field name="id" type="measure"/></graph></field>
    </record>
    <record id="action_reconcile_dashboard" model="ir.actions.act_window"><field name="name">Reconciliation Dashboard</field><field name="res_model">reconcile.case</field><field name="view_mode">graph,pivot,list,form</field></record>
    <record id="action_reconcile_tolerances" model="ir.actions.act_window"><field name="name">Tolerances</field><field name="res_model">reconcile.tolerance</field><field name="view_mode">list,form</field><field name="groups_id" eval="[(4, ref('account_reconcile_mcp_support.group_reconcile_approver'))]"/></record>
    <menuitem id="menu_reconcile_root" name="Reconciliation" parent="account.menu_finance" sequence="25" groups="account_reconcile_mcp_support.group_reconcile_user"/>
    <menuitem id="menu_reconcile_cases" name="Cases" parent="menu_reconcile_root" action="action_reconcile_cases" sequence="10"/>
    <menuitem id="menu_reconcile_dashboard" name="Dashboard" parent="menu_reconcile_root" action="action_reconcile_dashboard" sequence="5"/>
    <menuitem id="menu_reconcile_tolerances" name="Tolerances" parent="menu_reconcile_root" action="action_reconcile_tolerances" sequence="30" groups="account_reconcile_mcp_support.group_reconcile_approver"/>
</odoo>
