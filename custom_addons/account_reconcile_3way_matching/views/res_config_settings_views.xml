<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_reconcile" model="ir.ui.view">
        <field name="name">res.config.settings.form.purchase.reconcile</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Reconciliation Controls">
                    <setting string="Block vendor bills without three-way matching" help="Require a matched, tolerated or approved result before posting a vendor bill.">
                        <field name="reconcile_block_unmatched_purchase_bills"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
