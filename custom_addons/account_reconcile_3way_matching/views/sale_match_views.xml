<?xml version="1.0" encoding="utf-8"?><odoo>
<record id="view_sale_match_list" model="ir.ui.view"><field name="name">reconcile.sale.match.list</field><field name="model">reconcile.sale.match</field><field name="arch" type="xml"><list><field name="name"/><field name="invoice_id"/><field name="partner_id"/><field name="variance_amount"/><field name="exception_count"/><field name="state" widget="badge"/></list></field></record>
<record id="view_sale_match_form" model="ir.ui.view"><field name="name">reconcile.sale.match.form</field><field name="model">reconcile.sale.match</field><field name="arch" type="xml"><form string="Sales Fulfilment Match"><header><button name="action_compute" type="object" string="Recompute" class="btn-primary"/><button name="action_approve" type="object" string="Approve" groups="purchase.group_purchase_manager" invisible="state != 'exception'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="invoice_id"/><field name="company_id"/><field name="partner_id"/></group><group><field name="variance_amount"/><field name="exception_count"/></group></group><field name="line_ids"><list><field name="product_id"/><field name="sale_line_ids" widget="many2many_tags"/><field name="ordered_quantity"/><field name="delivered_quantity"/><field name="invoiced_quantity"/><field name="expected_amount"/><field name="actual_amount"/><field name="variance_amount"/><field name="result" widget="badge"/></list></field></sheet><chatter/></form></field></record>
<record id="action_sale_matches" model="ir.actions.act_window"><field name="name">Sales Matches</field><field name="res_model">reconcile.sale.match</field><field name="view_mode">list,form</field></record>
<record id="view_move_form_sale_match" model="ir.ui.view"><field name="name">account.move.form.sale.match</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_open_sale_reconcile_match" type="object" string="Sales Match" class="btn-secondary" invisible="move_type not in ('out_invoice', 'out_refund')" groups="account.group_account_invoice"/></xpath></field></record>
<menuitem id="menu_sale_matches" name="Sales Matches" parent="menu_reconcile_matching_root" action="action_sale_matches" sequence="20"/>
</odoo>
